{
  "version": 1,
  "tactics_glossary": {
    "authority": {
      "name": "Hacerse pasar por alguien oficial",
      "explanation": "Los estafadores dicen ser un banco, una autoridad o un jefe para que no hagas preguntas.",
      "safer": "Di que vas a devolver la llamada a un número que ya tienes."
    },
    "deadline": {
      "name": "Plazo artificial",
      "explanation": "Una cuenta atrás corta te impide pensar o consultar a alguien.",
      "safer": "Los problemas reales pueden esperar cinco minutos. Ve más despacio."
    },
    "fear": {
      "name": "Miedo a perder o a ser detenido",
      "explanation": "Las amenazas hacen que actúes antes de verificar.",
      "safer": "Cuelga y comprueba por el canal oficial."
    },
    "fake_proof": {
      "name": "Prueba falsa",
      "explanation": "Citan un dato, envían un mensaje que parece real o muestran una captura.",
      "safer": "Los datos se pueden robar. Verifica por tu cuenta."
    },
    "secrecy": {
      "name": "\"No se lo digas a nadie\"",
      "explanation": "El secreto bloquea a la persona que descubriría la estafa.",
      "safer": "Cuéntaselo enseguida a alguien de confianza."
    },
    "isolation": {
      "name": "\"No cuelgues\"",
      "explanation": "Mantenerte en la llamada te impide comprobar.",
      "safer": "Terminar la llamada siempre está permitido."
    },
    "emotion": {
      "name": "Presión emocional",
      "explanation": "Una voz que llora o está asustada, incluso una conocida, apaga el pensamiento cuidadoso.",
      "safer": "Usa una palabra clave familiar o llama a su número de siempre."
    },
    "rush": {
      "name": "Prisa",
      "explanation": "\"Se me va el autobús\" convierte cualquier espera en un insulto.",
      "safer": "Un cliente de verdad puede esperar la confirmación."
    },
    "fake_alert": {
      "name": "Alerta falsa",
      "explanation": "Un mensaje que parece un aviso de abono del banco no prueba que llegó el dinero.",
      "safer": "Revisa el saldo en tu propia app del banco."
    }
  },
