{
  "version": 1,
  "tactics_glossary": {
    "authority": {
      "name": "Se faire passer pour quelqu'un d'officiel",
      "explanation": "Les escrocs se disent banque, administration ou patron pour que vous ne posiez pas de questions.",
      "safer": "Dites que vous rappellerez sur un numéro que vous avez déjà."
    },
    "deadline": {
      "name": "Délai artificiel",
      "explanation": "Un compte à rebours court vous empêche de réfléchir ou de demander conseil.",
      "safer": "Un vrai problème peut attendre cinq minutes. Ralentissez."
    },
    "fear": {
      "name": "Peur de perdre ou d'être arrêté",
      "explanation": "Les menaces vous poussent à agir avant de vérifier.",
      "safer": "Raccrochez, puis vérifiez par le canal officiel."
    },
    "fake_proof": {
      "name": "Fausse preuve",
      "explanation": "Ils citent un détail, envoient un message qui a l'air vrai ou montrent une capture d'écran.",
      "safer": "Les détails peuvent être volés. Vérifiez par vous-même."
    },
    "secrecy": {
      "name": "« N'en parlez à personne »",
      "explanation": "Le secret écarte la personne qui repérerait l'arnaque.",
      "safer": "Parlez-en tout de suite à quelqu'un de confiance."
    },
    "isolation": {
      "name": "« Restez en ligne »",
      "explanation": "Vous garder au téléphone vous empêche de vérifier.",
      "safer": "Vous avez toujours le droit de raccrocher."
    },
    "emotion": {
      "name": "Pression émotionnelle",
      "explanation": "Une voix qui pleure ou panique, même familière, coupe la réflexion.",
      "safer": "Utilisez un mot de passe familial ou appelez son vrai numéro."
    },
    "rush": {
      "name": "Précipitation",
      "explanation": "« Mon bus part » fait passer toute attente pour une insulte.",
      "safer": "Un vrai client peut attendre la confirmation."
    },
    "fake_alert": {
      "name": "Fausse alerte",
      "explanation": "Un message qui ressemble à une alerte de crédit bancaire ne prouve pas que l'argent est arrivé.",
      "safer": "Vérifiez le solde dans votre propre appli bancaire."
    }
  },
